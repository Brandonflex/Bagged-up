{
  "name": "bagged-up",
  "version": "3.0.0",
  "private": true,
  "description": "Bagged Up storefront, a static site (plain HTML/CSS/JS) with no framework.",
  "scripts": {
    "verify": "npm audit --audit-level=low && npm run lint && npm run typecheck && npm run design && npm test && npm run build",
    "test": "node scripts/test-site.mjs && node scripts/test-app.mjs",
    "lint": "npm run lint:html && npm run lint:js",
    "lint:html": "html-validate \"*.html\" \"shop/*.html\"",
    "lint:js": "eslint assets/js",
    "typecheck": "tsc -p jsconfig.json",
    "build": "node scripts/build-site.mjs",
    "design": "node scripts/check-design.mjs",
    "layout": "node scripts/check-layout.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
