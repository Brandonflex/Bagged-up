 "type": {
  "display": {
   "family": "serif",
   "weights": "300-700",
   "usage": "headings, wordmark, pull quotes"
  },
  "text": {
   "family": "sans",
   "weights": "100-900",
   "usage": "body, buttons, labels, meta"
  },
  "scale": {
   "h1": "clamp(2.6rem, 7vw, 5.4rem), line-height 1.04, tracking -0.015em",
   "h1-page": "clamp(2.1rem, 4.6vw, 3.1rem), line-height 1.08",
   "h2": "clamp(1.9rem, 4.4vw, 3.1rem), line-height 1.08",
   "h3": "1.45rem",
   "price": "1.85rem, weight 600",
   "lede": "1.12rem, ink-soft",
   "name": "1.12rem, serif, weight 500",
   "body": "1rem, line-height 1.65",
   "small": "0.9rem",
   "meta": "0.8rem",
   "overline": "0.7rem, uppercase, tracking 0.2em, ink-faint",
   "badge": "0.62rem"
  }
 },
 "space": {
  "section": "clamp(3rem, 7vw, 5.5rem)",
  "section-tight": "clamp(2rem, 5vw, 3.4rem)",
  "container": "min(1220px, 92vw)",
  "gap": "1rem / 1.5rem / 2rem",
  "steps": "0.1 / 0.15 / 0.2 / 0.25 / 0.3 / 0.4 / 0.5 / 0.6 / 0.7 / 0.8 / 0.9 / 1 / 1.1 / 1.2 / 1.4 / 1.5 / 1.6 / 2 / 2.2 / 3 / 3.2 / 4 / 5.5 rem; 0.1 and 0.15 are micro steps for tight elements only"
 },
 "geometry": {
  "radius": "2px",
  "border-width": "1px",
  "header-height": "72px",
  "photo-ratio": "4 / 4.7 on product pages, 4:5 source photos"
 },
 "motion": {
  "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
  "reveal": "IntersectionObserver, 0.12 threshold, 700ms fallback",
  "rules": "respect prefers-reduced-motion; no parallax; nothing motion-only carries information"
 },
 "imagery": {
  "product": "4:5, ~1000px wide, plain warm background, natural daylight, no heavy retouching",
  "styling": "one lifestyle frame per category, shot in the same light as the product photos",
  "naming": "assets/products/<slug>-1.jpg, -2.jpg, ... in catalogue order"
 },
 "voice": {
  "rules": [
   "plain sentences, contractions allowed, second person",
   "no em dashes anywhere (enforced by the suite)",
   "specific over superlative: say the fee, the timing, the material",
   "no rule-of-three padding, no abstract benefits, no hype adjectives",
   "if a claim cannot be checked, it does not go on the page"
  ],
  "words_we_avoid": [
   "exquisite",
   "effortless",
   "luxurious",
   "curated",
   "elevate",
   "unlock",
   "seamless"
  ],
  "words_we_use": [
   "inspected",
   "in stock",
   "pay on delivery",
   "countrywide",
   "WhatsApp"
  ]
 }
}
