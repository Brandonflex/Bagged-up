{
  "$comment": "Bagged Up design tokens. This is the source of truth: scripts/check-design.mjs fails the build if assets/css/style.css drifts from these values, or if any declared contrast pair drops below its minimum. Palette: ivory / espresso / olive / muted gold.",
  "meta": {
    "name": "Bagged Up",
    "updated": "2026-10-04",
    "wcag": "AA body text (4.5:1), 3:1 for control boundaries and non-text"
  },

  "tokens": {
    "light": {
      "bg": "#FAF7F1",
      "bg-raised": "#F1EBE1",
      "bg-dark": "#201A15",
      "bg-dark-2": "#2B231C",
      "ink": "#211B15",
      "ink-soft": "#6E6459",
      "ink-faint": "#716758",
      "line": "#E3DBCE",
      "line-strong": "#8F8372",
      "line-dark": "rgba(250, 247, 241, 0.14)",
      "green": "#4D5A42",
      "green-deep": "#3D4834",
      "green-tint": "#EDF0E8",
      "green-line": "#DDE3D5",
      "link-line": "rgba(61, 72, 52, 0.3)",
      "cta-bg": "#4D5A42",
      "cta-ink": "#FFFFFF",
      "cta-bg-hover": "#3D4834",
      "cta-ink-hover": "#FFFFFF",
      "gold": "#8A6A3D",
      "white": "#FFFFFF",
      "header-bg": "rgba(250, 247, 241, 0.92)",
      "quick-bg": "rgba(250, 247, 241, 0.94)",
      "scrim": "rgba(24, 19, 14, 0.45)",
      "shadow-soft": "0 18px 50px -18px rgba(33, 27, 21, 0.28)",
      "serif": "'Cormorant Garamond', Georgia, 'Times New Roman', serif",
      "sans": "'Jost', 'Avenir Next', 'Segoe UI', system-ui, sans-serif",
      "radius": "2px",
      "header-h": "72px",
      "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)"
    },
    "dark": {
      "bg": "#171310",
      "bg-raised": "#1E1914",
      "ink": "#F0EAE0",
      "ink-soft": "#B5AB9D",
      "ink-faint": "#918679",
      "line": "#332B23",
      "line-strong": "#756A5C",
      "green": "#55644A",
      "green-deep": "#93A87D",
      "green-tint": "rgba(147, 168, 125, 0.12)",
      "green-line": "rgba(147, 168, 125, 0.28)",
      "link-line": "rgba(147, 168, 125, 0.4)",
      "cta-bg": "#93A87D",
      "cta-ink": "#211C17",
      "cta-bg-hover": "#A9BC93",
      "cta-ink-hover": "#211C17",
      "gold": "#C9A76B",
      "white": "#211C17",
      "header-bg": "rgba(23, 19, 16, 0.9)",
      "quick-bg": "rgba(30, 25, 20, 0.94)",
      "scrim": "rgba(0, 0, 0, 0.6)",
      "shadow-soft": "0 18px 50px -18px rgba(0, 0, 0, 0.65)"
    }
  },

  "contrast": [
    { "theme": "light", "name": "body text", "fg": "ink", "bg": "bg", "min": 4.5 },
    { "theme": "light", "name": "body text on raised", "fg": "ink", "bg": "bg-raised", "min": 4.5 },
    { "theme": "light", "name": "secondary text", "fg": "ink-soft", "bg": "bg", "min": 4.5 },
    { "theme": "light", "name": "secondary text on raised", "fg": "ink-soft", "bg": "bg-raised", "min": 4.5 },
    { "theme": "light", "name": "meta text", "fg": "ink-faint", "bg": "bg", "min": 4.5 },
    { "theme": "light", "name": "meta text on raised", "fg": "ink-faint", "bg": "bg-raised", "min": 4.5 },
    { "theme": "light", "name": "gold accent text", "fg": "gold", "bg": "bg", "min": 4.5 },
    { "theme": "light", "name": "link text", "fg": "green-deep", "bg": "bg", "min": 4.5 },
    { "theme": "light", "name": "primary button label", "fg": "cta-ink", "bg": "cta-bg", "min": 4.5 },
    { "theme": "light", "name": "primary button label (hover)", "fg": "cta-ink-hover", "bg": "cta-bg-hover", "min": 4.5 },
    { "theme": "light", "name": "field boundary", "fg": "line-strong", "bg": "bg", "min": 3 },
    { "theme": "light", "name": "field boundary on input fill", "fg": "line-strong", "bg": "white", "min": 3 },
    { "theme": "dark", "name": "body text", "fg": "ink", "bg": "bg", "min": 4.5 },
    { "theme": "dark", "name": "body text on raised", "fg": "ink", "bg": "bg-raised", "min": 4.5 },
    { "theme": "dark", "name": "secondary text", "fg": "ink-soft", "bg": "bg", "min": 4.5 },
    { "theme": "dark", "name": "secondary text on raised", "fg": "ink-soft", "bg": "bg-raised", "min": 4.5 },
    { "theme": "dark", "name": "meta text", "fg": "ink-faint", "bg": "bg", "min": 4.5 },
    { "theme": "dark", "name": "meta text on raised", "fg": "ink-faint", "bg": "bg-raised", "min": 4.5 },
    { "theme": "dark", "name": "gold accent text", "fg": "gold", "bg": "bg", "min": 4.5 },
    { "theme": "dark", "name": "link text", "fg": "green-deep", "bg": "bg", "min": 4.5 },
    { "theme": "dark", "name": "primary button label", "fg": "cta-ink", "bg": "cta-bg", "min": 4.5 },
    { "theme": "dark", "name": "primary button label (hover)", "fg": "cta-ink-hover", "bg": "cta-bg-hover", "min": 4.5 },
    { "theme": "dark", "name": "field boundary", "fg": "line-strong", "bg": "bg-raised", "min": 3 },
    { "theme": "dark", "name": "field boundary on input fill", "fg": "line-strong", "bg": "white", "min": 3 }
  ],

  "type": {
    "display": { "family": "serif", "weights": "300-700", "usage": "headings, wordmark, pull quotes" },
    "text": { "family": "sans", "weights": "100-900", "usage": "body, buttons, labels, meta" },
    "scale": {
      "h1": "clamp(2.6rem, 7vw, 5.4rem), line-height 1.04, tracking -0.015em",
      "h2": "clamp(1.9rem, 4.4vw, 3.1rem), line-height 1.08",
      "h3": "1.45rem",
      "lede": "1.12rem, ink-soft",
      "body": "1rem, line-height 1.65",
      "overline": "0.7rem, uppercase, tracking 0.2em, ink-faint",
      "button": "0.8rem, uppercase, tracking 0.14em"
    }
  },

  "space": {
    "section": "clamp(3rem, 7vw, 5.5rem)",
    "section-tight": "clamp(2rem, 5vw, 3.4rem)",
    "container": "min(1220px, 92vw)",
    "gap": "1rem / 1.5rem / 2rem"
  },

  "geometry": {
    "radius": "2px",
    "border-width": "1px",
    "header-height": "72px",
    "photo-ratio": "4 / 4.7 on product pages, 4:5 source photos"
  },

  "motion": {
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "reveal": "IntersectionObserver, 0.12 threshold, 700ms fallback",
    "rules": "respect prefers-reduced-motion; no parallax; nothing motion-only carries information"
  },

  "imagery": {
    "product": "4:5, ~1000px wide, plain warm background, natural daylight, no heavy retouching",
    "styling": "one lifestyle frame per category, shot in the same light as the product photos",
    "naming": "assets/products/<slug>-1.jpg, -2.jpg, ... in catalogue order"
  },

  "voice": {
    "rules": [
      "plain sentences, contractions allowed, second person",
      "no em dashes anywhere (enforced by the suite)",
      "specific over superlative: say the fee, the timing, the material",
      "no rule-of-three padding, no abstract benefits, no hype adjectives",
      "if a claim cannot be checked, it does not go on the page"
    ],
    "words_we_avoid": ["exquisite", "effortless", "luxurious", "curated", "elevate", "unlock", "seamless"],
    "words_we_use": ["inspected", "in stock", "pay on delivery", "countrywide", "WhatsApp"]
  }
}
